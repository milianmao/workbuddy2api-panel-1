# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json
API_KEY.txt

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
# 注意：用 docs/* 而非 docs/。忽略目录本身会让 Git 不再向下遍历，
# 下面针对 docs/project-note 的反向规则就永远不生效。
docs/*
!docs/project-note/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
!AGENTS.md

# 项目知识库（knowledge-base-builder 产出，下游 Skill 直接按路径读取）：
# 必须显式反忽略——上面的 *.md 会连 docs/project-note/*.md 一起吞掉。
!docs/project-note/**/*.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
# 抓包取证脚本与原始报文（issue #51 等）；结论写进 issue，不进仓库
/capture/
*.zip
server.exe

# 编译产物（16MB 误提交过一次，20261021）
/server
/app.toml
